# Set default figure size
figure.figsize : 13, 12

# Set x axis
xtick.major.size : 15
xtick.major.width : 2
xtick.minor.size : 10
xtick.minor.width : 1
xtick.direction : in
xtick.top : True
xtick.minor.visible : True

# Set y axis
ytick.major.size : 15
ytick.major.width : 2
ytick.minor.size : 10
ytick.minor.width : 1
ytick.direction : in
ytick.right : True
ytick.minor.visible : True

# Fontsizes
xtick.labelsize : 30
ytick.labelsize : 30
xtick.major.pad : 7
legend.fontsize : 30
legend.title_fontsize : 35
axes.titlesize : 30
axes.labelsize : 30

# Line widths
axes.linewidth : 2.5
grid.linewidth : 1
lines.linewidth : 3

# Font style
font.family : serif
text.usetex : True
font.size : 28.0

# margins
axes.xmargin : 0
axes.ymargin : 0

# Legend
legend.frameon : False

# Grid
grid.linestyle: --